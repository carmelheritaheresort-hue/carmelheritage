<%- include('_top', { title: 'Booking ' + b.ref }) %>
<p><a href="/admin/bookings">&larr; All bookings</a></p>
<h1>Booking <%= b.ref %> <span class="badge b-<%= b.status %>"><%= LABEL[b.status] %></span></h1>
<% if (saved) { %><p class="ok" role="status">Saved.</p><% } %>
<% if (b.status === 'paid') { %><p class="warn" role="note">The guest has paid. Check the rooms, then set the status to <strong>Confirmed</strong> and tell the guest. If you cannot provide the rooms, refund the payment in Razorpay and set the status to <strong>Refunded</strong>.</p><% } %>
<%- include('_guest-badge', { guest: guest }) %>
<% if (b.provider === 'dev') { %><p class="warn" role="note">TEST booking made on a development server. No money was taken.</p><% } %>
<dl class="details">
  <dt>Guest</dt><dd><%= b.name %></dd>
  <dt>Phone</dt><dd><a href="tel:<%= b.phone %>"><%= b.phone %></a> &middot; <a href="https://wa.me/<%= b.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener">WhatsApp</a></dd>
  <dt>Email</dt><dd><a href="mailto:<%= b.email %>"><%= b.email %></a></dd>
  <dt>Check-in</dt><dd><%= b.check_in %></dd>
  <dt>Check-out</dt><dd><%= b.check_out %> (<%= b.nights %> night<%= b.nights === 1 ? '' : 's' %>)</dd>
  <dt>Guests</dt><dd><%= b.adults %> adults, <%= b.children %> children</dd>
  <% b.rooms.forEach(function (r) { %><dt><%= r.label %></dt><dd><%= r.units %> &times; <%= rupees(r.rate * 100) %> a night = <%= rupees(r.amount) %></dd><% }) %>
  <dt>Room total</dt><dd><%= rupees(b.subtotal_paise) %></dd>
  <dt>GST (<%= b.gst_percent %>%)</dt><dd><%= rupees(b.gst_paise) %></dd>
  <dt>Total</dt><dd><strong><%= rupees(b.total_paise) %></strong></dd>
  <dt>Online payment</dt><dd><%= rupees(b.pay_now_paise) %><%= b.paid_at ? ' paid ' + fmtDateTime(b.paid_at) : ' (not paid)' %></dd>
  <% if (b.balance_paise > 0) { %><dt>Balance at the Centre</dt><dd><%= rupees(b.balance_paise) %></dd><% } %>
  <dt>Payment</dt><dd><%= b.provider || '-' %><%= b.provider_order_id ? ' · order ' + b.provider_order_id : '' %><%= b.provider_payment_id ? ' · payment ' + b.provider_payment_id : '' %>
    <% if (gatewayUrl) { %> &middot; <a href="<%= gatewayUrl %>" target="_blank" rel="noopener">Open in Razorpay</a><% } %></dd>
  <dt>Booked</dt><dd><%= fmtDateTime(b.created_at) %></dd>
  <dt>Guest message</dt><dd class="pre"><%= b.message || '-' %></dd>
</dl>
<form method="post" action="/admin/bookings/<%= b.id %>" class="stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (next.length) { %>
  <div class="field"><label for="status">Change status</label>
    <select id="status" name="status">
      <option value="">Keep: <%= LABEL[b.status] %></option>
      <% next.forEach(function (s) { %><option value="<%= s %>"><%= LABEL[s] %></option><% }) %>
    </select>
    <p class="help">Refunds are made in the Razorpay Dashboard. Set "Refunded" here after you have refunded there.</p></div>
  <% } %>
  <div class="field"><label for="internal_notes">Internal notes (never shown to guests)</label>
    <textarea id="internal_notes" name="internal_notes" rows="6"><%= b.internal_notes %></textarea></div>
  <button class="btn" type="submit">Save</button>
</form>
<%- include('_bottom') %>
