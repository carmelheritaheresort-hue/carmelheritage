<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title><%= title %> | Admin</title>
<link rel="icon" href="/img/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/img/favicon-192.png">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<% if (locals.user) { const role = user.role; %>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="admin-bar">
  <strong>Carmel admin</strong>
  <nav aria-label="Admin">
    <a href="/admin">Dashboard</a>
    <% if (role === 'admin' || role === 'staff') { %><a href="/admin/bookings">Bookings</a><a href="/admin/guests">Guests</a><a href="/admin/enquiries">Enquiries</a><% } %>
    <% if (role === 'admin' || role === 'editor') { %>
      <a href="/admin/content/accommodation">Accommodation</a>
      <a href="/admin/content/packages">Packages</a>
      <a href="/admin/content/treatments">Treatments</a>
      <a href="/admin/content/facilities">Facilities</a>
      <a href="/admin/content/gallery">Gallery</a>
      <a href="/admin/content/faqs">FAQs</a>
      <a href="/admin/content/testimonials">Testimonials</a>
      <a href="/admin/content/management">Management</a>
    <% } %>
    <% if (role === 'admin') { %><a href="/admin/settings">Settings</a><a href="/admin/checklist">Pre-launch</a><a href="/admin/users">Users</a><% } %>
    <a href="/admin/account">Account</a>
    <a href="/" target="_blank" rel="noopener">View site</a>
  </nav>
  <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="btn-link">Sign out (<%= user.name %>)</button></form>
</header>
<% } %>
<main id="main" class="admin-main">
