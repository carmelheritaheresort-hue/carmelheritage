<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <%- include('partials/page-hero', { heroEyebrow: 'Ayurveda in Kothamangalam', heroTitle: 'Ayurveda <em>treatments</em>', heroLead: 'Classical Ayurvedic medicines, treatments and therapies at Bhoothathankettu, near Kothamangalam.', heroImage: s.treatments_image, heroAlt: s.treatments_image_alt }) %>
  <section class="section" aria-labelledby="our-trt-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Kerala Ayurveda</p>
        <h2 id="our-trt-h">Our Ayurvedic <em>Treatments</em></h2>
        <img class="ornament" src="/img/ornament.svg" alt="" width="200" height="20">
        <p class="lead"><%= s.treatments_intro %></p>
      </div>
      <% if (treatments.length) { %>
        <div class="tiles trt-grid">
          <% treatments.forEach(function (t) { %><%- include('partials/treatment-card', { t: t, headingTag: 'h3' }) %><% }) %>
        </div>
        <div class="btn-row center mt">
          <a class="btn btn-primary" href="/ayurveda-packages">View treatment packages and prices</a>
        </div>
      <% } else { %>
        <div class="empty-state">
          <img src="/img/logo-emblem.png" alt="" width="72" height="71">
          <p>The Centre's treatment details will be published here once they have been approved. In the meantime, please contact the Centre to ask about treatments.</p>
        </div>
      <% } %>
    </div>
  </section>
  <section class="section-tight bg-parchment">
    <div class="container narrow center">
      <p class="note">Ayurveda treatments are not a substitute for medical advice, and no result can be promised. Contact the Centre to ask whether a treatment is suitable for you.</p>
      <div class="btn-row center">
        <a class="btn btn-primary" href="/enquiry?type=treatment">Send a treatment enquiry</a>
        <a class="btn btn-whatsapp" href="<%= waLink('Hello ' + s.site_name + ', I\u2019d like to ask about Ayurveda treatments.') %>" target="_blank" rel="noopener" data-track="WhatsApp Click">Ask on WhatsApp</a>
      </div>
    </div>
  </section>
  <%- include('partials/cta') %>
</main>
<%- include('partials/footer') %>
