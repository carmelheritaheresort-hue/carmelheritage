<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <%- include('partials/page-hero', { heroEyebrow: 'Ayurveda', heroTitle: 'Ayurveda <em>treatments</em>', heroLead: 'Classical Ayurvedic medicines, treatments and therapies.', heroImage: s.treatments_image, heroAlt: s.treatments_image_alt }) %>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="lead"><%= s.treatments_intro %></p>
      </div>
      <% if (treatments.length) { %>
        <div class="tiles">
          <% treatments.forEach(function (t) {
               const q = 'Hello ' + s.site_name + ', I\u2019d like to ask about ' + t.name + '. Please let me know whether it is suitable and available, and confirm the applicable rate.'; %>
            <article class="tile" id="treatment-<%= t.id %>">
              <h2><%= t.name %></h2>
              <% if (t.summary) { %><p><strong><%= t.summary %></strong></p><% } %>
              <%- renderText(t.description) %>
              <% if (t.duration || t.price || t.practitioner) { %>
              <dl class="facts">
                <% if (t.duration) { %><dt>Duration</dt><dd><%= t.duration %></dd><% } %>
                <% if (t.price) { %><dt>Price</dt><dd><%= t.price %></dd><% } %>
                <% if (t.practitioner) { %><dt>Practitioner</dt><dd><%= t.practitioner %></dd><% } %>
              </dl>
              <% } %>
              <div class="btn-row">
                <a class="btn btn-whatsapp btn-sm" href="<%= waLink(q) %>" target="_blank" rel="noopener" data-track="WhatsApp Click">WhatsApp<span class="sr-only"> about <%= t.name %></span></a>
                <a class="btn btn-outline btn-sm" href="/enquiry?type=treatment&amp;treatment=<%= encodeURIComponent(t.name) %>">Enquire<span class="sr-only"> about <%= t.name %></span></a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <img src="/img/logo-emblem.png" alt="" width="72" height="71">
          <p>The Centre's treatment details will be published here once they have been approved. In the meantime, please contact the Centre to ask about treatments.</p>
        </div>
      <% } %>
    </div>
  </section>
  <section class="section-tight bg-parchment">
    <div class="container narrow center">
      <p class="note">Ayurveda treatments are not a substitute for medical advice, and no result can be promised. Contact the Centre to ask whether a treatment is suitable for you.</p>
      <div class="btn-row center">
        <a class="btn btn-primary" href="/enquiry?type=treatment">Send a treatment enquiry</a>
        <a class="btn btn-whatsapp" href="<%= waLink('Hello ' + s.site_name + ', I\u2019d like to ask about Ayurveda treatments.') %>" target="_blank" rel="noopener" data-track="WhatsApp Click">Ask on WhatsApp</a>
      </div>
    </div>
  </section>
  <%- include('partials/cta') %>
</main>
<%- include('partials/footer') %>
