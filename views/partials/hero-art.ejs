<figure class="hero-media">
  <% if (s.hero_image) { %>
    <%- img(s.hero_image, s.hero_image_alt, { eager: true }) %>
  <% } else { %>
    <img src="/img/illustration-hero.svg" alt="" width="1600" height="900" fetchpriority="high">
    <figcaption class="illus-label">Illustration only. Not a photograph of the property.</figcaption>
  <% } %>
</figure>
