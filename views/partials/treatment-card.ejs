<%
  // Params: t (treatment row), headingTag
  const H = locals.headingTag || 'h3';
  const q = 'Hello ' + s.site_name + ', I\u2019d like to ask about ' + t.name + '. Please let me know whether it is suitable for me and available.';
%>
<article class="tile trt-card reveal" id="treatment-<%= t.id %>">
  <div class="tile-media">
    <% if (t.photo) { %><%- img(t.photo, t.photo_alt || t.name) %><% } else { %>
      <div class="ph trt-ph" aria-hidden="true"><img src="/img/logo-emblem-gold.png" alt="" width="256" height="253"></div>
    <% } %>
  </div>
  <<%= H %>><%= t.name %></<%= H %>>
  <% if (t.summary) { %><p><%= t.summary %></p><% } %>
  <%- renderText(t.description) %>
  <% if (t.duration || t.price || t.practitioner) { %>
  <dl class="facts">
    <% if (t.duration) { %><dt>Duration</dt><dd><%= t.duration %></dd><% } %>
    <% if (t.price) { %><dt>Price</dt><dd><%= t.price %></dd><% } %>
    <% if (t.practitioner) { %><dt>Practitioner</dt><dd><%= t.practitioner %></dd><% } %>
  </dl>
  <% } %>
  <div class="btn-row">
    <a class="btn btn-whatsapp btn-sm" href="<%= waLink(q) %>" target="_blank" rel="noopener" data-track="WhatsApp Click">WhatsApp<span class="sr-only"> about <%= t.name %> (opens in a new tab)</span></a>
    <a class="btn btn-outline btn-sm" href="/enquiry?type=treatment&amp;treatment=<%= encodeURIComponent(t.name) %>">Enquire<span class="sr-only"> about <%= t.name %></span></a>
  </div>
</article>
