<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const tab = function (m, href, label) { return '<a class="tab" href="' + href + '"' + (mode === m ? ' aria-current="page"' : '') + '>' + label + '</a>'; };
  const heroTitles = { stay: 'Booking <em>enquiry</em>', treatment: 'Treatment <em>enquiry</em>', package: 'Package booking <em>enquiry</em>' };
  const notes = {
    stay: 'availability and the applicable rate',
    treatment: 'suitability, availability and the applicable rate',
    package: 'availability and the booking procedure for your package'
  };
%>
<main id="main">
  <%- include('partials/page-hero', {
    heroEyebrow: 'Enquire',
    heroTitle: heroTitles[mode],
    heroLead: mode === 'package' ? 'Check the package below, add your details and WhatsApp opens with your enquiry ready to send.' : 'Fill in the form and WhatsApp opens with your message ready to send.',
    heroExtra: '<p class="tabs" role="navigation" aria-label="Enquiry type">' + tab('stay', '/enquiry', 'Stay enquiry') + tab('treatment', '/enquiry?type=treatment', 'Treatment enquiry') + tab('package', '/enquiry?type=package', 'Package enquiry') + '</p>'
  }) %>
  <section class="section bg-parchment">
    <div class="container narrow">
      <div class="note">
        <p><strong>This is an enquiry, not a confirmed booking.</strong> The Centre will reply to confirm <%= notes[mode] %>. Nothing is reserved until the Centre tells you so.<% if (mode === 'package') { %> Package prices cover the treatments listed; accommodation and food are charged separately.<% } %></p>
      </div>
      <div class="form-card mt">
        <%- include('partials/enquiry-form', { formId: 'main-form', formMode: mode, formPref: pref, formTreatment: prefTreatment, formPackage: formPackage }) %>
      </div>
      <p class="small center mt">You can also call <% phones.forEach(function (p, i) { %><a href="<%= tel(p) %>"><%= p %></a><%= i < phones.length - 1 ? ' or ' : '' %><% }) %>.<% if (mode === 'package') { %> <a href="/ayurveda-packages">See all packages</a>.<% } %></p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
