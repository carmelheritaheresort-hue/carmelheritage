# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Public base URL, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
SITE_URL=http://localhost:3000

# Set to 1 when running behind a reverse proxy (set automatically on Vercel).
TRUST_PROXY=0

# Supabase Postgres: Supabase dashboard > Connect > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=
# Optional: pin Supabase's CA certificate (Project Settings > Database > SSL Configuration), with \n for line breaks.
DATABASE_CA_CERT=

# Supabase Storage for uploaded photos: Project Settings > API Keys > secret key (sb_secret_...).
# Server-side only. Never put this key in browser code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=uploads

# Vercel Cron: any long random string. Vercel sends it to /api/cron/housekeeping once a day.
CRON_SECRET=

# Old local files, used only once by "npm run import-sqlite" to copy them to Supabase.
DATABASE_PATH=./data/carmel.db
UPLOAD_DIR=./data/uploads

# Optional fallback booking WhatsApp number, international format, digits only (no +, spaces).
# Used only if the admin setting is "Environment value" or resolves to empty.
WHATSAPP_NUMBER=

# Optional email notifications for new enquiries. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Carmel Heritage <no-reply@example.com>"
# Fallback recipient if the admin "Notification email" setting is empty
NOTIFY_EMAIL=

# Online booking payments (Razorpay). Get keys from Razorpay Dashboard > Account & Settings > API Keys.
# Use rzp_test_... keys while testing and rzp_live_... keys after Razorpay activates the account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret on the webhook: Dashboard > Webhooks > URL https://YOUR-SITE/api/payments/razorpay/webhook
# Events: order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Development only: with no Razorpay keys, the booking page offers a "simulate payment" button.
# Set to 0 to turn that off. It never works when NODE_ENV=production.
DEV_PAYMENTS=1

# Optional privacy-friendly analytics (Plausible-compatible). Leave empty to disable.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=https://plausible.io/js/script.js
